---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";
import TOC from "./TOC.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	lang?: string;
}

const { class: className, headings, lang } = Astro.props;
const isPostRoute = Astro.url.pathname.includes("/posts/");
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile lang={lang}></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        <Categories class="onload-animation" style="animation-delay: 150ms" lang={lang}></Categories>
        <Tag class="onload-animation" style="animation-delay: 200ms" lang={lang}></Tag>
        {siteConfig.toc.enable && isPostRoute && headings && headings.length > 0 && <div class="hidden lg:block">
            <div class="card-base rounded-[var(--radius-large)] p-3">
                <div class="mb-2 px-2 text-sm font-bold text-black/75 dark:text-white/75">
                    {lang === "vi" ? "Mục lục" : "Table of contents"}
                </div>
                <TOC headings={headings} compact={true}></TOC>
            </div>
        </div>}
    </div>
</div>
